# Copy to ~/.ea-private/zulip.env (mode 600, outside the repo) and fill
# every value. deploy/zulip/.env (gitignored) still works as a fallback;
# deploy/zulip/env.sh says where the file is looked for.
# Generate each one with:  openssl rand -hex 16
# Values must be one line with no quotes. Changing the postgres password
# after first boot needs an ALTER ROLE in the database; the others can change
# with a restart.
ZULIP__POSTGRES_PASSWORD=change-me
ZULIP__MEMCACHED_PASSWORD=change-me
ZULIP__RABBITMQ_PASSWORD=change-me
ZULIP__REDIS_PASSWORD=change-me
ZULIP__SECRET_KEY=change-me

# The address the server is reached at (the tailnet name and the https
# port the proxy listens on) and the realm owner's email.
ZULIP_EXTERNAL_HOST=<host>.<tailnet>.ts.net:8443
ZULIP_ADMIN_EMAIL=<your gmail>

# The realm owner's web login password (README step 3). Compose ignores it.
# Generate with:  openssl rand -hex 12
ZULIP_OWNER_PASSWORD=change-me
